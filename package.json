{
  "name": "@swal/edge-mesh",
  "version": "1.0.0",
  "workspaces": [
    ".",
    "packages/*"
  ],
  "description": "Owner-controlled P2P mesh for the browser: Yjs CRDT sync over WebRTC with post-quantum (ML-DSA-65, ML-KEM-768 + ECDH) signed security state",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js",
      "default": "./dist/web/index.js"
    },
    "./web/trust": {
      "types": "./dist/web/trust/index.d.ts",
      "import": "./dist/web/trust/index.js",
      "default": "./dist/web/trust/index.js"
    },
    "./web/oplog": {
      "types": "./dist/web/oplog/index.d.ts",
      "import": "./dist/web/oplog/index.js",
      "default": "./dist/web/oplog/index.js"
    },
    "./web/merge": {
      "types": "./dist/web/merge/index.d.ts",
      "import": "./dist/web/merge/index.js",
      "default": "./dist/web/merge/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsc -w",
    "test": "node tests/run-tests.js",
    "test:audit": "node tests/run-tests.js --config vitest.audit.config.ts",
    "test:watch": "vitest",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "check": "npx tsc --noEmit",
    "bench": "npm run build && node scripts/bench.js",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "y-indexeddb": "9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "cbor-x": "1.6.6",
    "ethers": "^6.17.0",
    "idb": "^8.0.4",
    "peerjs": "^1.5.5",
    "ws": "^8.22.0"
  },
  "peerDependenciesMeta": {
    "@bokuweb/zstd-wasm": {
      "optional": true
    },
    "cbor-x": {
      "optional": true
    },
    "ethers": {
      "optional": true
    },
    "idb": {
      "optional": true
    },
    "peerjs": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@bokuweb/zstd-wasm": "0.0.27",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "cbor-x": "1.6.6",
    "ethers": "^6.17.0",
    "idb": "^8.0.4",
    "peerjs": "^1.5.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "keywords": [
    "p2p",
    "mesh",
    "crdt",
    "yjs",
    "webrtc",
    "post-quantum",
    "ml-dsa",
    "ml-kem",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iberi22/edge-mesh.git"
  },
  "homepage": "https://github.com/iberi22/edge-mesh#readme",
  "bugs": {
    "url": "https://github.com/iberi22/edge-mesh/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
